{
  "name": "@iechor/loop-init",
  "version": "1.4.0",
  "description": "Scaffold loop engineering patterns and starters. Grok, Claude, Codex, Opencode, Cursor, Trae, VS Code. npx @iechor/loop-init . --pattern daily-triage --tool vscode",
  "type": "module",
  "bin": {
    "loop-init": "dist/cli.js"
  },
  "files": [
    "dist",
    "starters",
    "templates",
    "README.md"
  ],
  "scripts": {
    "bundle": "node scripts/bundle-assets.mjs",
    "build": "npm run bundle && tsc",
    "test": "npm run build && node --test test/cli.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "scaffold",
    "starter",
    "claude-code",
    "grok",
    "codex",
    "opencode",
    "github-actions",
    "patterns",
    "cursor",
    "trae",
    "vscode"
  ],
  "author": "iechor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iechor/loops-automatic-researching.git",
    "directory": "tools/loop-init"
  },
  "homepage": "https://github.com/iechor/loops-automatic-researching",
  "bugs": {
    "url": "https://github.com/iechor/loops-automatic-researching/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iechor/loop-audit": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
